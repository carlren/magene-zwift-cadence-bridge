[Unit]
Description=Cadence Bridge relay API
After=network.target

[Service]
Type=simple
User=cadence-bridge
Group=cadence-bridge
WorkingDirectory=/opt/cadence-bridge
EnvironmentFile=/etc/cadence-bridge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cadence-bridge/.venv/bin/gunicorn --bind 127.0.0.1:18240 --workers 1 --threads 4 --timeout 15 app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
